# Copy to .env and fill in the three required values. Everything else has a sensible
# default (see spec.md §11); uncomment a line to override it.

# --- Required ------------------------------------------------------------------------------
# Bot token (xoxb-...): Slack app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-...) with the connections:write scope: Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token
# OpenRouter API key (sk-or-...): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key

# --- LLM models (any OpenRouter model id) -------------------------------------------------------
# Shortcut: use one model for every task below (the fallback is not affected).
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_MODEL_JARGON=anthropic/claude-sonnet-5
# LLM_MODEL_JUDGE=anthropic/claude-sonnet-5
# LLM_MODEL_QUIP=anthropic/claude-sonnet-5
# LLM_MODEL_MODERATION=anthropic/claude-haiku-4.5
# Used when a task's model fails; keep it on a different vendor.
# LLM_MODEL_FALLBACK=openai/gpt-4o-mini
# LLM_TIMEOUT_SECONDS=15
# Wait before the single retry of jargon generation or judging, before the game ends.
# LLM_FAILURE_RETRY_SECONDS=30

# --- Storage ----------------------------------------------------------------------------------
# Docker sets /data/jargonator.db. For local runs use a relative path:
# DATABASE_URL=sqlite+aiosqlite:///./data/jargonator.db

# --- Scoring --------------------------------------------------------------------------------
# POINTS_FIRST=10
# POINTS_SECOND=5
# POINTS_THIRD=1
# WRITER_BONUS_POINTS=10
# The writer gets the bonus when the best judge score (0-100) is below this.
# WRITER_BONUS_THRESHOLD=50

# --- Timing (seconds) -------------------------------------------------------------------------
# Defaults shown in the start form:
# DEFAULT_GUESS_SECONDS=60
# DEFAULT_WRITER_SECONDS=90
# DEFAULT_JOIN_WINDOW_SECONDS=120
# WRITER_REMINDER_SECONDS=30
# MAX_CONSECUTIVE_MISSES=3
# HOST_CLAIM_AFTER_SECONDS=300
# IDLE_TIMEOUT_SECONDS=7200
# MIN_PLAYERS=2

# --- Operations -------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# HEALTH_PORT=8080
